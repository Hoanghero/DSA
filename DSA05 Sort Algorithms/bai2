#include <stdio.h>
#include <time.h>
#include <stdlib.h>
void sinhMang(int arr[], int n, int min, int max) {
    for (int i = 0; i < n; i++) {
        arr[i] = min + rand() % (max - min + 1);
    }
}
void swap(int *a, int *b) {
    int temp = *a;
    *a=*b;
    *b=temp;
}
void selectionSort(int arr[], int n, int *comps, int *swaps) {
    int min, j1;
    for (int i=0; i<n; i++) {
        min = arr[i];
        for (int j=i+1; j<n; j++) {
            (*comps)++;
            if (arr[j] < min) {
                min = arr[j];
                j1=j;
            }
        }
        if (min!=arr[i]) {
            swap(&arr[j1], &arr[i]);
            (*swaps)++;
        }
    }
}
float trungBinhCong(int arr[], int n, int m) {
    float tong = 0;
    for (int i = 0; i < n; i++) {
        tong += (float)(i* arr[i]);
    }
    return tong/m;
}
int main() {
    time_t t;
    srand((unsigned)time(&t));
    int arr[100];
    int k[] = {100, 1000, 10000, 100000};
    for (int u=0; u<4; u++) {
        int danhDauComps[1000] = {};
        int danhDauSwaps[1000] = {};
        for (int i=0; i<k[u]; i++) {
            int comps=0, swaps=0;
            sinhMang(arr,10,-1000,1000);
            selectionSort(arr,10, &comps, &swaps);
            danhDauComps[comps]++;
            danhDauSwaps[swaps]++;
        }
        for (int l=0; l<1000; l++) {
            if (danhDauComps[l]!=0) printf("So sanh %d lan: %d\n", l, danhDauComps[l]);
        }
        printf("Mean comps: %.2f\n", trungBinhCong(danhDauComps, 1000, k[u]));
        for (int l=0; l<1000; l++) {
            if (danhDauSwaps[l]!=0) printf("Hoan doi %d lan: %d\n", l, danhDauSwaps[l]);
        }
        printf("Mean swaps: %.2f\n", trungBinhCong(danhDauSwaps, 1000, k[u]));
        printf("----------------------\n");
    }
    return 0;
}